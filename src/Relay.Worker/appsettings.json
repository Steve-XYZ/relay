{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.Hosting.Lifetime": "Information"
    }
  },
  "Relay": {
    "ServerUrl": "http://localhost:8080",
    "WorkerName": "local-worker",
    "LeaseSeconds": 15,
    "HeartbeatSeconds": 5,
    "ClaimIntervalSeconds": 2,
    "WorkspaceRoot": "/tmp/relay-workspaces",
    "SandboxMode": "docker",
    "SandboxImage": "relay-sandbox:latest"
  },
  "Otel": {
    "OtlpEndpoint": ""
  }
}
